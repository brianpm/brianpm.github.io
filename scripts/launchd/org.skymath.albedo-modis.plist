<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.skymath.albedo-modis</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/brianpm/Code/brianpm.github.io/scripts/cron_update_albedo_modis.sh</string>
    </array>

    <!-- 06:00 local time on the 6th of every month (clears MCD43C3's ~9-day latency) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/brianpm/Code/brianpm.github.io/scripts/logs/albedo_modis_launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/brianpm/Code/brianpm.github.io/scripts/logs/albedo_modis_launchd.err</string>
</dict>
</plist>
